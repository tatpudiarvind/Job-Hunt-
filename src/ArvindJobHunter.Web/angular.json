{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "arvind-job-hunter-web": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "ajh",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "../../bin/ArvindJobHunter.Web/browser",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "index": "src/index.html",
            "polyfills": ["zone.js"],
            "assets": [],
            "styles": ["src/styles.scss"]
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "arvind-job-hunter-web:build"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "buildTarget": "arvind-job-hunter-web:build",
            "runner": "vitest"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "490f3193-b725-476a-ab1e-005ff5fee637"
  }
}
